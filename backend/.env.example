# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1
# Reverse proxies in front of the app (Render = 1, local dev = 0). Makes req.ip / rate limits per client.
TRUST_PROXY_HOPS=0
# Set to "true" on deployed servers: the app then refuses to start with the public dev JWT secrets / in-memory DB.
STRICT_ENV=false

# MongoDB — must be a replica set (Atlas free tier qualifies) so multi-document
# transactions work for atomic order creation / stock deduction.
# Local example: mongodb://127.0.0.1:27017/saree_ecommerce?replicaSet=rs0
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/saree_ecommerce

# JWT
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,https://vinit-textiles.vercel.app

# Razorpay. While these are blank, checkout offers Cash on Delivery only and every online-payment
# endpoint is disabled (so no order can be marked paid without a real payment).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# LOCAL DEVELOPMENT ONLY: uncomment to exercise the online-payment flow with a fake gateway that accepts
# any payment. Never set this on a deployed server.
# ALLOW_STUB_PAYMENTS=true

# Business rules
LOW_STOCK_THRESHOLD=5
FREE_SHIPPING_THRESHOLD=2000
STANDARD_SHIPPING_FEE=99

# Resend (email OTP for login/signup) — leave blank in development to fall back
# to logging the code server-side instead of emailing it.
# Get a key at https://resend.com — the default FROM address works without
# verifying a domain, but delivery is limited to your own Resend account email
# until a sending domain is verified.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Vinit Textiles <onboarding@resend.dev>

# Delhivery shipping (pincode serviceability + tracking). Get a token at one.delhivery.com > Settings > API and MCP Setup
DELHIVERY_API_TOKEN=
# DELHIVERY_BASE_URL=https://track.delhivery.com

# Clerk customer sign-in. Required: without it /auth/clerk-sync refuses to issue tokens (customers can sign in
# on the site but cannot place orders). Use the same secret key as the Clerk "Production" instance
# (Clerk dashboard > API keys > Secret keys). Never commit it.
CLERK_SECRET_KEY=
# CLERK_ISSUER=https://clerk.vinittextiles.com
